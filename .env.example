# https://cloud.browser-use.com/billing
BROWSER_USE_API_KEY=""

# https://resend.com/
RESEND_API_KEY=""

# NOTE: You can use `onboarding@resend.dev`` to send email to your account in the testing phase.
#       We recommend you verify your domain when rolling out QA Use internally.
RESEND_FROM_EMAIL="Example <onboarding@resend.dev>"

# --- Local Mode (optional) ---
# Set BROWSER_USE_MODE=local to use the local runner instead of BrowserUse Cloud.
# Then start with: docker compose --profile local up
#
# BROWSER_USE_MODE=local
# BROWSER_USE_LOCAL_URL=http://local-runner:8000
#
# Pick one LLM provider and fill in its credentials:
# LLM_PROVIDER=azure_openai
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_DEPLOYMENT=o4-mini
#
# LLM_PROVIDER=openai
# OPENAI_API_KEY=
#
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
#
# LLM_PROVIDER=google
# GOOGLE_API_KEY=